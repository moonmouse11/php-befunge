{
    "name": "pots/php-befunge",
    "description": "A Befunge-93 interpreter library for PHP with injectable input, strict types and no global state.",
    "type": "library",
    "license": "MIT",
    "keywords": ["befunge", "befunge-93", "interpreter", "esoteric", "esolang"],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pots\\PhpBefunge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pots\\PhpBefunge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis on src/.",
        "test": "Run the PHPUnit test suite."
    }
}
