<?xml version="1.0"?>
<ruleset name="php-befunge">
    <description>PSR-12 coding standard for src/ and tests/.</description>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="warning-severity" value="0"/>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <!-- Test methods intentionally use snake_case names (it_does_something). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
